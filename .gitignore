# binaries & profiles
*.test
*.out
*.prof
/bin/
# spill-audit artifacts (archived per-commit under docs/ssa when wanted)
ssa.html
# gate scratch: build/ssa holds one ssa.html per audited kernel, ~5 MB each.
# Not committed — the gate regenerates it on every run, and a stale copy would be
# worse than none when writing docs/spill-report.md.
/build/
# bench scratch
bench/results/*.local.*
# machine-local remote execution targets (see .keel-hosts.example, docs/hosts.md)
/.keel-hosts
# machine-local P3 gate target: the throughput regression sentinel. Hostnames are
# infrastructure, not source; absent means "every host", never "skip the check"
# (scripts/gate-p3.sh criterion 5). There is no OpenBLAS reference-host list any
# more — the ruling on issue #23 made the reference same-host on every gate host.
/.keel-sentinel
